<!--
  Custom Wazuh rules for the credential-attack lab.
  Install: copy into /var/ossec/etc/rules/local_rules.xml on the manager, then restart wazuh-manager.
  Validate with /var/ossec/bin/wazuh-logtest using the lines in ../../samples/.
  Status (v0.1): written against the Wazuh 4.x ruleset, NOT yet validated in the lab.
  Lab addressing: admin workstation 192.168.100.50 is the only source allowed to log in over SSH.
-->
<group name="local,sshd,credential_lab,">

  <!-- Brute force: 5 authentication failures from the same IP within 60 s -->
  <rule id="100100" level="10" frequency="5" timeframe="60">
    <if_matched_group>authentication_failed</if_matched_group>
    <same_srcip />
    <description>Lab: possible SSH brute force from $(srcip) (5 failures in 60s)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,pci_dss_11.4,</group>
  </rule>

  <!-- Successful SSH login from any source other than the admin workstation -->
  <rule id="100101" level="12">
    <if_sid>5715</if_sid>
    <srcip negate="yes">192.168.100.50</srcip>
    <description>Lab: SSH login for $(dstuser) from non-allowlisted source $(srcip)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

  <!-- Success after a brute-force alert from the same IP: likely compromised credential -->
  <rule id="100102" level="13" timeframe="600">
    <if_group>authentication_success</if_group>
    <if_matched_group>authentication_failures</if_matched_group>
    <same_srcip />
    <description>Lab: SSH login from $(srcip) after repeated failures - possible compromised account</description>
    <mitre>
      <id>T1078</id>
      <id>T1110</id>
    </mitre>
  </rule>

</group>
